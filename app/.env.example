# 阿里云百炼 DashScope（OpenAI 兼容接口）
# 从「默认业务空间-apiKey-*.csv」获取你自己的密钥后填入此处，并重命名为 .env
LLM_API_KEY=sk-ws-your-api-key-here
LLM_BASE_URL=https://llm-jo3aa3w7x9si9ghp.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 降级链：主模型 → 备用模型（手册 §1.2 第 4 条）
# 赛题全案 §2.5 推荐 Qwen3-Max；日常评测用 qwen-plus 省成本，发布前终测换 qwen3-max
LLM_MODEL_PRIMARY=qwen-plus
LLM_MODEL_SECONDARY=qwen-turbo

# 视觉模型（Qwen-VL，走同一个 OpenAI 兼容端点）
VL_MODEL_PRIMARY=qwen-vl-plus
VL_MODEL_SECONDARY=qwen-vl-max

# 语音识别（Paraformer，走 DashScope 原生 RESTful，独立 baseURL）
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=paraformer-v2

# Gateway 模式：live=真实调用并写回 cassette；replay=命中 cassette 直接返回（CI 零成本）
# CI 流水线应设为 replay，本地开发可设为 live
LLM_GATEWAY_MODE=live
