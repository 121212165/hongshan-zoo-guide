{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../app/src/*"]
    }
  },
  "include": ["./**/*.ts", "../app/src/**/*.ts", "../app/src/**/*.tsx"]
}
